---
interface Props {
  name: "print" | "back" | "up" | "down" | "arrow-right" | "sliders";
  size?: number;
}

const { name, size = 16 } = Astro.props;
---

{name === "print" && (
  <svg
    aria-hidden="true"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    class="btn-icon"
  >
    <path
      d="M6 9V2h12v7"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <rect
      x="6"
      y="14"
      width="12"
      height="8"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}
{name === "back" && (
  <svg
    aria-hidden="true"
    width={size}
    height={size}
    viewBox="0 0 16 12"
    fill="none"
    class="back-arrow"
  >
    <path
      d="M14.5 6H1.5M5 2.5 1.5 6 5 9.5"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}
{name === "up" && (
  <svg
    aria-hidden="true"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    class="back-arrow"
  >
    <path
      d="M12 19V5M5 12l7-7 7 7"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}
{name === "down" && (
  <svg
    aria-hidden="true"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    class="back-arrow"
  >
    <path
      d="M12 5v14M5 12l7 7 7-7"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}
{name === "arrow-right" && (
  <svg width={size} height={size} viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}
{name === "sliders" && (
  <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none">
    <path
      d="M4 8h9M17 8h3M4 16h3M11 16h9"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
    />
    <circle cx="15" cy="8" r="2.2" stroke="currentColor" stroke-width="1.8" />
    <circle cx="9" cy="16" r="2.2" stroke="currentColor" stroke-width="1.8" />
  </svg>
)}

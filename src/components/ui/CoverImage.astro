---
/**
 * Cover image with intrinsic dimensions (no CLS), async decoding and
 * correct loading priority. First items in a grid/hero use `eager` +
 * `fetchpriority="high"`; everything else stays lazy.
 */
import { imageSize } from "@/lib/images";

interface Props {
  src: string;
  alt: string;
  class?: string;
  eager?: boolean;
}

const { src, alt, class: className = "image", eager = false } = Astro.props;
const { width, height } = imageSize(src);
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
  class={className}
/>

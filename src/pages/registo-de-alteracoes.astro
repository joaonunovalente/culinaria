---
import Page from "@/layouts/Page.astro";
---

<Page title="Registo de alterações" description="Registo de alterações da Culinária.">
  <section class="section">
    <div class="container">
      <div class="_12-columns">
        <div class="column desktop-6 tablet-12">
          <div class="text-center">
            <h1 class="heading xxl">Registo de Alterações</h1>
            <p>Histórico de versões com todas as alterações feitas ao sítio.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section no-top-padding">
    <div class="container">
      <div class="_12-columns space-between">
        <div class="column desktop-12">
          <div class="cl-item">
            <div class="cl-heading-wrapper">
              <h2 class="heading xs">Versão 1.4</h2>
              <p class="cl-date">Publicada em outubro de 2026</p>
            </div>
            <div class="cl-text-wrapper">
              <p>Reformulação da página de impressão de receitas.</p>
            </div>
          </div>
        </div>
        <div class="column desktop-12">
          <div class="cl-item">
            <div class="cl-heading-wrapper">
              <h2 class="heading xs">Versão 1.3</h2>
              <p class="cl-date">Publicada em outubro de 2026</p>
            </div>
            <div class="cl-text-wrapper">
              <p>
                Reformulação da página <a href="/categorias">Categorias</a>.
              </p>
            </div>
          </div>
        </div>
        <div class="column desktop-12">
          <div class="cl-item">
            <div class="cl-heading-wrapper">
              <h2 class="heading xs">Versão 1.2</h2>
              <p class="cl-date">Publicada em outubro de 2026</p>
            </div>
            <div class="cl-text-wrapper">
              <p>Adição da funcionalidade de impressão de receitas.</p>
            </div>
          </div>
        </div>
        <div class="column desktop-12">
          <div class="cl-item">
            <div class="cl-heading-wrapper">
              <h2 class="heading xs">Versão 1.1</h2>
              <p class="cl-date">Publicada em outubro de 2026</p>
            </div>
            <div class="cl-text-wrapper">
              <p>Adição do tema escuro.</p>
              <p>Remoção das redes sociais da barra de navegação.</p>
              <p>Adição de sublinhado animado nas ligações da barra de navegação.</p>
            </div>
          </div>
        </div>
        <div class="column desktop-12">
          <div class="cl-item">
            <div class="cl-heading-wrapper">
              <h2 class="heading xs">Versão 1.0</h2>
              <p class="cl-date">Publicada em outubro de 2026</p>
            </div>
            <div class="cl-text-wrapper">
              <p>Versão inicial.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Page>

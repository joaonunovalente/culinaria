---
import Page from "@/layouts/Page.astro";
import Icon from "@/components/ui/Icon.astro";
import CoverImage from "@/components/ui/CoverImage.astro";
import {
  categories,
  categoryDescriptions,
  categorySlug,
  getCategoryStyle,
  type Category,
} from "@/config/categories";
import { getCollection } from "astro:content";
import { visibleRecipes } from "@/lib/recipes";

const allRecipes = visibleRecipes(await getCollection("recipes"));

const cards = categories.map((category: Category) => {
  const inCategory = allRecipes.filter((recipe) => recipe.data.category === category);
  const cover = inCategory[0]?.data.cover;
  const coverAlt = inCategory[0]?.data.coverAlt ?? `Receita de ${category.toLowerCase()}`;
  const style = getCategoryStyle(category);
  return {
    category,
    slug: categorySlug(category),
    description: categoryDescriptions[category],
    count: inCategory.length,
    cover,
    coverAlt,
    color: style.color,
    background: style.background,
  };
});

const totalRecipes = allRecipes.length;
---

<Page title="Categorias" description="Encontre a receita certa para o momento.">
  <section class="section">
    <div class="container">
      <div class="cat-hero fade-up">
        <p class="cat-eyebrow">Explora por momento</p>
        <h1 class="heading xxl">Categorias</h1>
        <p class="cat-subtitle">
          {totalRecipes} {totalRecipes === 1 ? "receita" : "receitas"} à espera — escolhe para onde
          vai a fome.
        </p>
      </div>

      <ul role="list" class="cat-grid">
        {cards.map((card, index) => (
          <li class="fade-up" style={`transition-delay:${Math.min(index * 60, 300)}ms`}>
            <a
              href={`/categorias/${card.slug}/`}
              class="cat-card"
              style={`--cat:${card.color};--cat-bg:${card.background}`}
            >
              <div class="cat-media">
                {card.cover ? (
                  <CoverImage
                    src={card.cover}
                    alt={card.coverAlt}
                    class="cat-image"
                    eager={index < 3}
                  />
                ) : (
                  <div class="cat-image-fallback" aria-hidden="true">
                    {card.category.charAt(0)}
                  </div>
                )}
                <span class="cat-count">
                  {card.count} {card.count === 1 ? "receita" : "receitas"}
                </span>
              </div>
              <div class="cat-body">
                <h2 class="cat-title">{card.category}</h2>
                <p class="cat-desc">{card.description}</p>
                <span class="cat-cta">
                  Ver receitas
                  <Icon name="arrow-right" />
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>

<style>
  .cat-hero {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .cat-eyebrow {
    margin: 0 0 12px;
    color: var(--gold);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .cat-hero .heading.xxl {
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .cat-subtitle {
    margin: 0;
    color: var(--grey);
    font-size: 18px;
    line-height: 1.6;
    text-wrap: balance;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .cat-grid > li {
    min-width: 0;
    height: 100%;
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 32px;
    background-color: var(--white);
    color: inherit;
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--cat) 18%, transparent);
    transition:
      transform 0.5s cubic-bezier(0.165, 0.84, 0.44, 1),
      box-shadow 0.5s cubic-bezier(0.165, 0.84, 0.44, 1),
      border-color 0.3s ease;
  }

  .cat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 40px 80px -32px color-mix(in srgb, var(--cat) 45%, transparent);
    border-color: color-mix(in srgb, var(--cat) 40%, transparent);
  }

  .cat-card:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .cat-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--cat-bg);
  }

  .cat-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .cat-card:hover .cat-image {
    transform: scale(1.05);
  }

  .cat-image-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--cat);
    font-family: Lora, serif;
    font-size: 64px;
    font-weight: 700;
  }

  .cat-count {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 8px 14px;
    border-radius: 100vw;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(6px);
    color: #1b2629;
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 8px 24px rgb(27 38 41 / 0.18);
  }

  html.dark .cat-count {
    background: rgb(21 19 18 / 0.88);
    color: #f3ece1;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.5);
  }

  .cat-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    flex: 1;
    padding: 28px 28px 30px;
  }

  .cat-title {
    margin: 0;
    color: var(--dark);
    font-family: Lora, serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .cat-desc {
    margin: 0;
    flex: 1;
    color: var(--grey);
    font-size: 16px;
    line-height: 1.6;
  }

  .cat-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    color: var(--dark);
    font-size: 15px;
    font-weight: 700;
  }

  .cat-cta svg {
    transition: transform 0.25s ease;
  }

  .cat-card:hover .cat-cta svg {
    transform: translateX(4px);
  }

  .cat-card:hover .cat-cta {
    color: var(--cat);
  }

  html.dark .cat-card:hover .cat-cta {
    color: color-mix(in srgb, var(--cat) 55%, white);
  }

  @media (max-width: 991px) {
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin-top: 44px;
    }
  }

  @media (max-width: 767px) {
    .cat-grid {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }

    .cat-subtitle {
      font-size: 16px;
    }

    .cat-title {
      font-size: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-card,
    .cat-image,
    .cat-cta svg {
      transition: none;
    }

    .cat-card:hover {
      transform: none;
    }

    .cat-card:hover .cat-image {
      transform: none;
    }
  }
</style>

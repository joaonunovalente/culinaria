---
import Page from "@/layouts/Page.astro";
---

<Page
  title="Página não encontrada"
  description="A página que procuras não existe ou foi movida."
  noindex
>
  <div class="utility-page-wrap">
    <div class="utility-page-content">
      <h1 class="heading l">Oh não!</h1>
      <div>A página que procuras não existe ou foi movida.</div>
      <div class="button-wrapper centered">
        <a href="/" class="button c-button">
          Voltar ao início
        </a>
      </div>
    </div>
  </div>
</Page>
